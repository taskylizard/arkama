name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  build:
    runs-on: ${{ matrix.os }}
    env:
      RUSTC_WRAPPER: ""
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]

    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy

      - uses: Swatinem/rust-cache@v2

      - name: cargo check
        run: cargo check

      - name: cargo test
        run: cargo test

      - name: cargo clippy
        run: cargo clippy --fix --allow-dirty

      - name: cargo fmt
        run: cargo fmt

      - name: cargo build release
        run: cargo build --release

      - name: package artifacts
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p dist
          if [[ "${{ runner.os }}" == "Windows" ]]; then
            cp target/release/arkama.exe dist/arkama-windows.exe
          elif [[ "${{ runner.os }}" == "macOS" ]]; then
            cp target/release/arkama dist/arkama-macos
          else
            cp target/release/arkama dist/arkama-linux
          fi

      - name: upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: arkama-${{ runner.os }}
          path: dist/*

  release:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          path: dist

      - name: zip artifacts
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          from pathlib import Path
          import zipfile

          rename = {
              "arkama-windows.exe": ("arkama-windows", "arkama-windows.exe"),
          }

          for path in Path("dist").rglob("*"):
              if path.is_file() and not path.name.endswith(".zip"):
                  zip_name, arcname = rename.get(path.name, (path.name, path.name))
                  zip_path = path.with_name(f"{zip_name}.zip")
                  with zipfile.ZipFile(zip_path, "w", compression=zipfile.ZIP_DEFLATED) as zf:
                      zf.write(path, arcname=arcname)
          PY
          find dist -type f ! -name '*.zip' -delete

      - uses: softprops/action-gh-release@v2
        with:
          files: dist/**
